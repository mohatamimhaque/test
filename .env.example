# Server-Side / Migration Connection (Source Neon Database)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (Permanent Object Storage)
#
# These are read ONLY by the serverless functions in /api. They must NOT carry
# the VITE_ prefix: anything VITE_-prefixed is inlined into the public JavaScript
# bundle and would hand the bucket credential to every visitor.
#
# In Vercel, add these as server environment variables (no VITE_ prefix).
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=cse-alumni

# /api/photo-upload verifies the caller against this table, so it also needs to
# know which Supabase project to check. Safe to expose — the anon key is public.
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend Supabase Integration (Vite Exposed)
# VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-Side Supabase Keys (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
